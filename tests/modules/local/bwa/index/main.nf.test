nextflow_process {

    name "Test Process BWA_INDEX"
    script "modules/local/bwa/index/main.nf"
    process "BWA_INDEX"

    test("Should run without failures") {

        when {
            process {
                """
                input[0] = file("\${params.reference_genome}")
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

}
