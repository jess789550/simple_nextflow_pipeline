nextflow_process {

    name "Test Process BWA_MEM"
    script "modules/local/bwa/mem/main.nf"
    process "BWA_MEM"

    test("Should run without failures") {

        when {
            process {
                """
                input[0] = [
                    [id: "test", name: "test", project: "test"],
                    [
                        file("\${params.test_dir}/fastq/test_1.fastq.gz"),
                        file("\${params.test_dir}/fastq/test_2.fastq.gz")
                    ]
                ]
                input[1] =   [
                    file("\${params.reference_genome}"),
                    file("\${params.reference_genome}.amb"),
                    file("\${params.reference_genome}.ann"),
                    file("\${params.reference_genome}.pac"),
                    file("\${params.reference_genome}.bwt.2bit.64"),
                    file("\${params.reference_genome}.0123")
                ]
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

}
