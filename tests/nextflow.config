profiles {
    docker {
        docker.enabled = true
    }
}

params {
    reference_genome = "/data/dev/jess/test-datasets/data/genomics/homo_sapiens/genome/genome.fasta"
    test_dir = "/data/dev/jess/test-datasets/data/genomics/homo_sapiens/illumina/"
    vep_cache_dir = "/data/dev/jess/"
    vep_plugins_dir = "/data/resources/vep/Plugins"
}

docker {
    enabled = true
    runOptions = "--user ${System.getenv('UID_HOST')}:${System.getenv('GID_HOST')}"
}