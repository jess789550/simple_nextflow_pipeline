#!/bin/bash
### ---
### name: "BWAMEM (1)"
### container: "community.wave.seqera.io/library/bwa-mem2_samtools:ce303392aed31f97"
### outputs:
### - "TESTX_H7YRLADXX.bam"
### ...
set -e
set -u
NXF_DEBUG=${NXF_DEBUG:=0}; [[ $NXF_DEBUG > 1 ]] && set -x
NXF_ENTRY=${1:-nxf_main}


nxf_sleep() {
  sleep $1 2>/dev/null || sleep 1;
}

nxf_date() {
    local s n
    read s n < <(date '+%s %N')
    if [[ $n =~ ^[0-9]+$ ]]; then
        n=$(printf '%09d' "$((10#$n))")
        echo "$((s * 1000 + 10#${n:0:3}))"
    else
        echo "$((s * 1000))"
    fi
}

nxf_env() {
    echo '============= task environment ============='
    env | sort | sed "s/\(.*\)AWS\(.*\)=\(.\{6\}\).*/\1AWS\2=\3xxxxxxxxxxxxx/"
    echo '============= task output =================='
}

nxf_kill() {
    declare -a children
    while read P PP;do
        children[$PP]+=" $P"
    done < <(ps -e -o pid= -o ppid=)

    kill_all() {
        [[ $1 != $$ ]] && kill $1 2>/dev/null || true
        for i in ${children[$1]:=}; do kill_all $i; done
    }

    kill_all $1
}

nxf_mktemp() {
    local base=${1:-/tmp}
    mkdir -p "$base"
    if [[ $(uname) = Darwin ]]; then mktemp -d $base/nxf.XXXXXXXXXX
    else TMPDIR="$base" mktemp -d -t nxf.XXXXXXXXXX
    fi
}

nxf_fs_copy() {
  local source=$1
  local target=$2
  local basedir=$(dirname $1)
  mkdir -p $target/$basedir
  cp -fRL $source $target/$basedir
}

nxf_fs_move() {
  local source=$1
  local target=$2
  local basedir=$(dirname $1)
  mkdir -p $target/$basedir
  mv -f $source $target/$basedir
}

nxf_fs_rsync() {
  local source=$1
  local target=$2
  mkdir -p $target
  rsync -rRl $source $target
}

nxf_fs_rclone() {
  rclone copyto $1 $2/$1
}

nxf_fs_fcp() {
  fcp $1 $2/$1
}

on_exit() {
    local last_err=$?
    local exit_status=${nxf_main_ret:=0}
    [[ ${exit_status} -eq 0 && ${nxf_unstage_ret:=0} -ne 0 ]] && exit_status=${nxf_unstage_ret:=0}
    [[ ${exit_status} -eq 0 && ${last_err} -ne 0 ]] && exit_status=${last_err}
    set +u
    printf -- $exit_status > /data/dev/jess/simple_nextflow_pipeline/work/21/cf7b401fa3407b57be35fbf8d586d1/.exitcode
    docker rm $NXF_BOXID &>/dev/null || true
    exit $exit_status
}

on_term() {
    set +e
    docker stop $NXF_BOXID
}

nxf_launch() {
    docker run -i --cpu-shares 2048 --memory 32768m -e "NXF_TASK_WORKDIR" -v /data:/data -w "$NXF_TASK_WORKDIR" --name $NXF_BOXID community.wave.seqera.io/library/bwa-mem2_samtools:ce303392aed31f97 /bin/bash -ue /data/dev/jess/simple_nextflow_pipeline/work/21/cf7b401fa3407b57be35fbf8d586d1/.command.sh
}

nxf_stage() {
    true
    # stage input files
    rm -f GRCh38_masked_v2_decoy_excludes_GPRIN2_DUSP22_FANCD2.fa.0123
    rm -f GRCh38_masked_v2_decoy_excludes_GPRIN2_DUSP22_FANCD2.fa
    rm -f GRCh38_masked_v2_decoy_excludes_GPRIN2_DUSP22_FANCD2.fa.amb
    rm -f GRCh38_masked_v2_decoy_excludes_GPRIN2_DUSP22_FANCD2.fa.bwt.2bit.64
    rm -f GRCh38_masked_v2_decoy_excludes_GPRIN2_DUSP22_FANCD2.fa.pac
    rm -f GRCh38_masked_v2_decoy_excludes_GPRIN2_DUSP22_FANCD2.fa.ann
    rm -f TESTX_H7YRLADXX_S1_L001_R1_001.fastq.gz
    rm -f TESTX_H7YRLADXX_S1_L001_R2_001.fastq.gz
    rm -f GRCh38_masked_v2_decoy_excludes_GPRIN2_DUSP22_FANCD2.fa.fai
    ln -sfn /data/resources/GRCh38_masked_v2_decoy_excludes_GPRIN2_DUSP22_FANCD2/GRCh38_masked_v2_decoy_excludes_GPRIN2_DUSP22_FANCD2.fa.0123 GRCh38_masked_v2_decoy_excludes_GPRIN2_DUSP22_FANCD2.fa.0123
    ln -sfn /data/resources/GRCh38_masked_v2_decoy_excludes_GPRIN2_DUSP22_FANCD2/GRCh38_masked_v2_decoy_excludes_GPRIN2_DUSP22_FANCD2.fa GRCh38_masked_v2_decoy_excludes_GPRIN2_DUSP22_FANCD2.fa
    ln -sfn /data/resources/GRCh38_masked_v2_decoy_excludes_GPRIN2_DUSP22_FANCD2/GRCh38_masked_v2_decoy_excludes_GPRIN2_DUSP22_FANCD2.fa.amb GRCh38_masked_v2_decoy_excludes_GPRIN2_DUSP22_FANCD2.fa.amb
    ln -sfn /data/resources/GRCh38_masked_v2_decoy_excludes_GPRIN2_DUSP22_FANCD2/GRCh38_masked_v2_decoy_excludes_GPRIN2_DUSP22_FANCD2.fa.bwt.2bit.64 GRCh38_masked_v2_decoy_excludes_GPRIN2_DUSP22_FANCD2.fa.bwt.2bit.64
    ln -sfn /data/resources/GRCh38_masked_v2_decoy_excludes_GPRIN2_DUSP22_FANCD2/GRCh38_masked_v2_decoy_excludes_GPRIN2_DUSP22_FANCD2.fa.pac GRCh38_masked_v2_decoy_excludes_GPRIN2_DUSP22_FANCD2.fa.pac
    ln -sfn /data/resources/GRCh38_masked_v2_decoy_excludes_GPRIN2_DUSP22_FANCD2/GRCh38_masked_v2_decoy_excludes_GPRIN2_DUSP22_FANCD2.fa.ann GRCh38_masked_v2_decoy_excludes_GPRIN2_DUSP22_FANCD2.fa.ann
    ln -sfn /data/dev/jess/simple_nextflow_pipeline/data/TESTX_H7YRLADXX_S1_L001_R1_001.fastq.gz TESTX_H7YRLADXX_S1_L001_R1_001.fastq.gz
    ln -sfn /data/dev/jess/simple_nextflow_pipeline/data/TESTX_H7YRLADXX_S1_L001_R2_001.fastq.gz TESTX_H7YRLADXX_S1_L001_R2_001.fastq.gz
    ln -sfn /data/resources/GRCh38_masked_v2_decoy_excludes_GPRIN2_DUSP22_FANCD2/GRCh38_masked_v2_decoy_excludes_GPRIN2_DUSP22_FANCD2.fa.fai GRCh38_masked_v2_decoy_excludes_GPRIN2_DUSP22_FANCD2.fa.fai
}

nxf_unstage_outputs() {
    true
}

nxf_unstage_controls() {
    true
}

nxf_unstage() {
    if [[ ${nxf_main_ret:=0} == 0 ]]; then
        (set -e -o pipefail; (nxf_unstage_outputs | tee -a .command.out) 3>&1 1>&2 2>&3 | tee -a .command.err) 3>&1 1>&2 2>&3
        nxf_unstage_ret=$?
    fi
    nxf_unstage_controls
}

nxf_main() {
    trap on_exit EXIT
    trap on_term TERM INT USR2
    trap '' USR1

    [[ "${NXF_CHDIR:-}" ]] && cd "$NXF_CHDIR"
    export NXF_BOXID="nxf-$(dd bs=18 count=1 if=/dev/urandom 2>/dev/null | base64 | tr +/ 0A | tr -d '\r\n')"
    NXF_SCRATCH=''
    [[ $NXF_DEBUG > 0 ]] && nxf_env
    touch /data/dev/jess/simple_nextflow_pipeline/work/21/cf7b401fa3407b57be35fbf8d586d1/.command.begin
    set +u
    set -u
    [[ $NXF_SCRATCH ]] && cd $NXF_SCRATCH
    export NXF_TASK_WORKDIR="$PWD"
    nxf_stage

    set +e
    (set -o pipefail; (nxf_launch | tee .command.out) 3>&1 1>&2 2>&3 | tee .command.err) 3>&1 1>&2 2>&3 &
    pid=$!
    wait $pid || nxf_main_ret=$?
    nxf_unstage
}

$NXF_ENTRY
